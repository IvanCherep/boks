   "ambience": {
    "effect": "rain",
    "intensity": 0.6,
    "wind": 0.6
   },
   "line": "In the fell clutch of circumstance / I have not winced nor cried aloud. / Under the bludgeonings of chance / My head is bloody, but unbow'd."
  },
  {
   "id": "gate",
   "image": "03_gate.png",
