     "y": 0.09,
     "width": 0.5,
     "height": 0.3
    }
   ],
   "line": "Not like the brazen giant of Greek fame, / With conquering limbs astride from land to land; / Here at our sea-washed, sunset gates shall stand",
   "startMs": 0
  },
  {
   "id": "mother-of-exiles",
   "image": "/poetry/new-colossus/scenes/02-mother-of-exiles.webp",
   "lines": 5,
   "focalPoint": {
    "x": 0.38,
    "y": 0.4
   },
   "textPreset": "searchlight-scan",
   "transitionMs": 1250,
   "safeZones": [
    {
     "x": 0.46,
     "y": 0.09,
     "width": 0.48,
     "height": 0.3
    }
   ],
   "line": "A mighty woman with a torch, whose flame / Is the imprisoned lightning, and her name / Mother of Exiles. From her beacon-hand / Glows world-wide welcome; her mild eyes command / The air-bridged harbor that twin cities frame.",
   "startMs": 10720
  },
  {
   "id": "huddled-masses",
   "image": "/poetry/new-colossus/scenes/03-huddled-masses.webp",
   "lines": 4,
   "focalPoint": {
    "x": 0.5,
    "y": 0.55
   },
   "textPreset": "quiet-breath",
   "transitionMs": 1250,
   "safeZones": [
    {
     "x": 0.08,
     "y": 0.09,
     "width": 0.84,
     "height": 0.3
    }
   ],
   "line": "\"Keep, ancient lands, your storied pomp!\" cries she / With silent lips. \"Give me your tired, your poor, / Your huddled masses yearning to breathe free, / The wretched refuse of your teeming shore.",
   "startMs": 27920
  },
  {
   "id": "golden-door",
   "image": "/poetry/new-colossus/scenes/04-golden-door.webp",
   "lines": 2,
   "focalPoint": {
    "x": 0.5,
    "y": 0.55
   },
   "textPreset": "farewell-drift",
   "transitionMs": 1500,
   "safeZones": [
    {
     "x": 0.08,
     "y": 0.09,
     "width": 0.84,
     "height": 0.3
    }
   ],
   "line": "Send these, the homeless, tempest-tost to me, / I lift my lamp beside the golden door!\"",
   "startMs": 42240
  }
 ],
