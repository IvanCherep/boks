   },
   "textPreset": "uniform-formation",
   "transitionMs": 1270,
   "safeZones": [
    {
     "x": 0.44,
     "y": 0.07,
     "width": 0.5,
     "height": 0.15
    }
   ],
   "line": "O Captain! my Captain! our fearful trip is done, / The ship has weather'd every rack, the prize we sought is won, / The port is near, the bells I hear, the people all exulting, / While follow eyes the steady keel, the vessel grim and daring; / But O heart! heart! heart! / O the bleeding drops of red, / Where on the deck my Captain lies, / Fallen cold and dead.",
   "startMs": 0
  },
  {
   "id": "arm-beneath-your-head",
   "image": "/poetry/o-captain/scenes/02-arm-beneath-your-head.webp",
   "lines": 6,
   "focalPoint": {
    "x": 0.35,
    "y": 0.6
   },
   "textPreset": "quiet-breath",
   "transitionMs": 1270,
   "safeZones": [
    {
     "x": 0.44,
     "y": 0.07,
     "width": 0.5,
     "height": 0.15
    }
   ],
   "line": "O Captain! my Captain! rise up and hear the bells; / Rise up—for you the flag is flung—for you the bugle trills, / For you bouquets and ribbon'd wreaths—for you the shores a-crowding, / For you they call, the swaying mass, their eager faces turning; / Here Captain! dear father! / This arm beneath your head!",
   "startMs": 29840
  },
  {
   "id": "some-dream",
   "image": "/poetry/o-captain/scenes/03-some-dream.webp",
   "lines": 2,
   "focalPoint": {
    "x": 0.7,
    "y": 0.45
   },
   "textPreset": "echo-fade",
   "transitionMs": 1270,
   "safeZones": [
    {
     "x": 0.4,
     "y": 0.07,
     "width": 0.54,
     "height": 0.15
    }
   ],
   "line": "It is some dream that on the deck, / You've fallen cold and dead.",
   "startMs": 53840
  },
  {
   "id": "mournful-tread",
   "image": "/poetry/o-captain/scenes/04-mournful-tread.webp",
   "lines": 8,
   "focalPoint": {
    "x": 0.4,
    "y": 0.55
   },
   "textPreset": "farewell-drift",
   "transitionMs": 1500,
   "safeZones": [
    {
     "x": 0.42,
     "y": 0.06,
     "width": 0.52,
     "height": 0.15
    }
   ],
   "line": "My Captain does not answer, his lips are pale and still, / My father does not feel my arm, he has no pulse nor will, / The ship is anchor'd safe and sound, its voyage closed and done, / From fearful trip the victor ship comes in with object won; / Exult O shores, and ring O bells! / But I with mournful tread, / Walk the deck my Captain lies, / Fallen cold and dead.",
   "startMs": 59040
  }
 ],
