   },
   "textPreset": "ridge-reveal",
   "transitionMs": 1320,
   "safeZones": [
    {
     "x": 0.46,
     "y": 0.08,
     "width": 0.46,
     "height": 0.22
    }
   ],
   "line": "I’ve heard it in the chillest land – / And on the strangest Sea –",
   "startMs": 19013
  },
  {
   "id": "strangest-sea",
   "image": "/poetry/hope-feathers/scenes/04-strangest-sea.webp",
   "lines": 2,
