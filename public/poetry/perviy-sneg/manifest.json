   },
   "textPreset": "farewell-drift",
   "transitionMs": 1500,
   "safeZones": [
    {
     "x": 0.06,
     "y": 0.08,
     "width": 0.5,
     "height": 0.17
    }
   ],
   "line": "Воплощение мечтаний, / Жизни с грёзою игра, / Этот мир очарований, / Этот мир из серебра!",
   "startMs": 24800
  }
