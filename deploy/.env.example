# Copy to /opt/boks/.env on the server (chmod 600). Never commit the real file.
SITE_HOST=tryboks.com
SITE_URL=https://tryboks.com

# Generated once: JWT secret, anon and service_role keys signed with it, DB password.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# Staging basic auth for pages (hash: `docker run --rm caddy:2.10 caddy hash-password -p ...`).
STAGING_USER=boks
STAGING_HASH=

# Email for sign-in codes. Test: the mailpit service (profile "testmail").
SMTP_ADMIN_EMAIL=hello@tryboks.com
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Auth email via Resend (deploy/mailer). HOOK_SECRET is shared with GoTrue: "v1,whsec_<base64 of 32 random bytes>".
RESEND_API_KEY=
HOOK_SECRET=
